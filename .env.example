# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini
# Free key from Google AI Studio (aistudio.google.com) -> "Get API key"
GEMINI_API_KEY=
# A model name listed in AI Studio, e.g. gemini-2.5-flash (check it is available to your key)
GEMINI_MODEL=

# Only if you later get SAP access (then set LLM_PROVIDER=sap):
# AICORE_SERVICE_KEY=
# GENAI_MODEL=
