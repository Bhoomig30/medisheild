{
  "name": "medisheild",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "manager": { "password": "", "roles": ["procurement_manager"] },
            "owner":   { "password": "", "roles": ["plant_owner"] },
            "viewer":  { "password": "", "roles": [] }
          }
        }
      },
      "db": {
        "[development]": {
          "model": ["db/schema.cds"]
        },
        "[production]": {
          "model": [
            "db/schema.cds",
            "db/hana/identity.cds"
          ]
        }
      }
    }
  },
  "private": true
}