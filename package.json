{
  "name": "medisheild",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "node --test test/match.test.js test/integration.test.js",
    "smoke": "node test/smoke.js",
    "live": "node test/live.js",
    "serve": "node src/server.js"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "model": [
            "db/schema.cds"
          ]
        },
        "[production]": {
          "model": [
            "db/schema.cds",
            "db/hana/identity.cds"
          ]
        }
      }
    }
  },
  "private": true,
  "optionalDependencies": {
    "@sap-ai-sdk/orchestration": "^1.0.0"
  }
}
